{
    "name": "razorpay-installer",
    "displayName": "Razorpay Pod Installer",
    "description": "Install Razorpay SDK with flavor options from right-click on .xcodeproj",
    "version": "1.0.0",
    "publisher": "nirman",
    "engines": {
        "vscode": "^1.86.0"
    },
    "activationEvents": [
        "onCommand:extension.installRazorpay"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "extension.installRazorpay",
                "title": "Install Razorpay SDK"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "extension.installRazorpay",
                    "when": "resourceExtname == .xcodeproj",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "tsc -p ./",
        "compile": "tsc"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.14.1",
        "@types/vscode": "^1.86.0",
        "@vscode/test-electron": "^2.1.5",
        "eslint": "^9.24.0",
        "mocha": "^11.1.0",
        "typescript": "^5.8.3",
        "vscode": "^1.1.34"
    },
    "dependencies": {
        "axios": "^1.8.4"
    }
}
